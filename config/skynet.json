{
  "output_file": "./events.jsonl",
  "alerts_file": "./alerts.json",
  "batch_size": 50,
  "flush_interval": 10,
  "host_id": "",
  "hostname": "",
  "enable_auth": true,
  "enable_process": true,
  "enable_network": true,
  "enable_file": true,
  "enable_usb": true,
  "enable_system": true,
  "enable_app": true,
  "poll_interval_auth": 5,
  "poll_interval_process": 10,
  "poll_interval_network": 15,
  "poll_interval_file": 10,
  "poll_interval_usb": 5,
  "poll_interval_system": 10,
  "poll_interval_app": 15,
  "auth_log_path": "/var/log/auth.log",
  "syslog_path": "/var/log/syslog",
  "ufw_log_path": "/var/log/ufw.log",
  "nginx_log_path": "/var/log/nginx/access.log",
  "mysql_log_path": "/var/log/mysql/error.log",
  "watch_paths": [
    "/etc",
    "/root",
    "/home"
  ],
  "queue_max_memory": 10000,
  "spool_dir": "./spool",
  "spool_max_mb": 100,
  "debug_mode": false,
  "log_file": "./skynet.log"
}
